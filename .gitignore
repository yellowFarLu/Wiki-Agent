# 构建产物
target/

# 运行时数据（H2 库、上传文件）。锚定仓库根目录：
# 不锚定的 `data/` 会同时吞掉 src/main/java/.../domain/eval/data/ 源码包（本次丢类事故的根因）
/data/

# 环境变量（含密钥，严禁入库）
.env

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# 日志
*.log
.worktrees/

# Python 字节码
__pycache__/
*.pyc

# 三阶段评测数据流水线：生产日志候选/驳回留痕含真实用户问答，严禁入库
# （流程见 docs/operations/eval-baseline.md §6.2；合成候选为虚构数据可入库）
eval/ragas/datasets/candidates-production.jsonl
eval/ragas/datasets/reviewed-rejected.jsonl
