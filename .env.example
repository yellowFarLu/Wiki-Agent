# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会入库）

# ============================================================
# 必填：外部 API
# ============================================================

# 阿里云百炼 API-Key（必填，sk- 开头）：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 模型（可选，默认如下）
# WIKIAGENT_CHAT_MODEL=qwen-plus
# WIKIAGENT_EMBEDDING_MODEL=text-embedding-v4

# ============================================================
# 本地中间件连接（默认直连本机；如部署在其他主机请改 host）
# ============================================================

# MySQL（默认 jdbc:mysql://localhost:3306/wikiagent，root/root）
# MYSQL_URL=jdbc:mysql://localhost:3306/wikiagent
# MYSQL_USER=root
MYSQL_PASSWORD=root

# Redis（默认 localhost:6379，无密码）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# RocketMQ NameServer（默认 127.0.0.1:9876）
# ROCKETMQ_NAME_SERVER=127.0.0.1:9876
# ROCKETMQ_HOME 仅在 start.sh 启动中间件时使用
# ROCKETMQ_HOME=$HOME/.local/share/rocketmq

# Presidio（默认 http://localhost:5050）
# PRESIDIO_URL=http://localhost:5050

# ============================================================
# Milvus（不在 start.sh 范围内，需自行部署；版本 >= 2.5 以支持 BM25）
# ============================================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USERNAME=root
MILVUS_PASSWORD=milvus

# ============================================================
# 可选：覆盖默认值（默认值已对齐生产口径）
# ============================================================
# 任务框架 MQ：默认 rocketmq；零依赖场景改为 local
# TASK_MQ=rocketmq
# Redis 总开关：默认 true；零依赖场景改为 false
# REDIS_ENABLED=true
# Session 存储：默认 redis；零依赖场景改为 none
# SESSION_STORE=redis
# 集中式 Session：默认 true
# WIKIAGENT_SESSION_REDIS=true

# 子项目 A：交接清单适配器（默认 mysql）
WIKIAGENT_MEMORY_HANDOVER_ADAPTER=mysql
WIKIAGENT_MEMORY_FILE_MIGRATION_ENABLED=false
WIKIAGENT_TASK_ENABLED=true
