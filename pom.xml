<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.wikiagent</groupId>
    <artifactId>wiki-agent</artifactId>
    <version>1.0.0</version>
    <name>wiki-agent</name>
    <description>Enterprise knowledge base with hybrid BM25 + vector retrieval (RAG)</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai-alibaba.version>1.1.2.0</spring-ai-alibaba.version>
        <spring-ai.version>1.1.2</spring-ai.version>
        <milvus-sdk-java.version>2.5.17</milvus-sdk-java.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <poi-ooxml.version>5.5.1</poi-ooxml.version>
        <tika.version>3.3.2</tika.version>
        <!-- 必须与 Spring Boot 3.5.x / spring-data-redis 3.5 对齐：3.45.0 传递的
             redisson-spring-data-34 未实现 3.5 新增的 pExpire(k,ms,ExpirationOptions.Condition)，
             会落入 DefaultedRedisConnection 默认方法自递归导致 StackOverflowError；
             3.52.0 改用 redisson-spring-data-35。 -->
        <redisson.version>3.52.0</redisson.version>
        <!-- 子项目 A：RocketMQ 经典 Remoting 客户端（避开 rocketmq-spring-starter 的 javax 兼容问题） -->
        <rocketmq.version>5.3.1</rocketmq.version>
        <!-- CI 集成测试：Testcontainers（MySQL/Redis/RocketMQ） -->
        <testcontainers.version>1.20.4</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 子项目 A：Testcontainers BOM 统一版本（CI 集成测试） -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- v6 §22.5 Redis 分布式锁 + 短期记忆 / Episodic Memory（StringRedisTemplate） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>${redisson.version}</version>
        </dependency>

        <!-- 子项目 A §1.4 RocketMQ 任务投递（经典 Remoting 客户端 5.3.1） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-client</artifactId>
            <version>${rocketmq.version}</version>
        </dependency>

        <!-- Spring AI Alibaba: DashScope Chat + Embedding（v6 验证：1.1.2.0 BOM 含本 starter） -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
            <version>${spring-ai-alibaba.version}</version>
        </dependency>

        <!-- v6 §21.3 Multi-Agent 编排：spring-ai-alibaba-agent-framework（ReactAgent + AgentTool + SupervisorConfig） -->
        <!-- 事实校正：原 §21.7 提及的 spring-ai-alibaba-graph 不存在，官方推荐 agent-framework 1.1.2.0 -->
        <!-- 已通过 mvn dependency:get 验证坐标可用 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-agent-framework</artifactId>
            <version>${spring-ai-alibaba.version}</version>
        </dependency>

        <!-- Milvus Java SDK V2 (hybrid search: dense + BM25 sparse) -->
        <dependency>
            <groupId>io.milvus</groupId>
            <artifactId>milvus-sdk-java</artifactId>
            <version>${milvus-sdk-java.version}</version>
        </dependency>

        <!-- Document parsing -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi-ooxml.version}</version>
        </dependency>
        <!-- 子项目 B：Tika 纯 Java 解析兜底（旧版 .doc/.xls 等；3.3.2 对齐 POI 5.5.1/PDFBox 3.0.8） -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>${tika.version}</version>
        </dependency>

        <!-- v1-v5 §11.1 基础设施依赖 -->

        <!-- MySQL 驱动（生产与测试统一使用真实 MySQL，不使用任何内嵌数据库） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway 数据库迁移（V1-V8 SQL 脚本） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Actuator + Prometheus（§8 全链路可观测指标暴露） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Resilience4j（§7 LLM 路由层降级/限流/重试） -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.2.0</version>
        </dependency>

        <!-- Spring Session Redis（§16 集中式 Session 兜底，接入层分级架构） -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>

        <!-- Spring AI Test 评测框架（§9 Agent 评测 + §13.1 单测） -->
        <!-- 实施校正：spring-ai-starter-test 不存在；BOM 实际管理的是 spring-ai-test -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 子项目 A：Testcontainers（CI 起 MySQL/Redis/RocketMQ 真实容器做集成测试） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- 单测与集成测试分离：surefire 排除 *IT（mvn test 不起容器），
                 failsafe 仅执行 *IT（mvn verify + Docker）；无 Docker 时 -Dtest.profile=light 跳过 IT -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          子项目 H 离线评测（规格 §H，AC-H2/H4）：
          mvn test -Peval
            - surefire 默认集 + **/eval/*IT.java（EvalOfflineIT），不跑其它 *IT（零 Docker）；
            - LiveLLM 标签默认排除；真实 LLM 烟雾测试仅人工：
              mvn test -Peval -Dtest=LiveLlmSmokeTest -Dsurefire.excludedGroups=
            - systemProperty 打开评测运行器开关并指定报告目录（不改 application.yml）。
        -->
        <profile>
            <id>eval</id>
            <properties>
                <eval.output.dir>target/eval-report</eval.output.dir>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/Test*.java</include>
                                <include>**/*Test.java</include>
                                <include>**/*Tests.java</include>
                                <include>**/*TestCase.java</include>
                                <include>**/eval/*IT.java</include>
                            </includes>
                            <excludedGroups>${surefire.excludedGroups:LiveLLM}</excludedGroups>
                            <systemPropertyVariables>
                                <wikiagent.eval.enabled>true</wikiagent.eval.enabled>
                                <wikiagent.eval.output-dir>${eval.output.dir}</wikiagent.eval.output-dir>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/eval/*IT.java</include>
                            </includes>
                            <excludedGroups>${surefire.excludedGroups:LiveLLM}</excludedGroups>
                            <systemPropertyVariables>
                                <wikiagent.eval.enabled>true</wikiagent.eval.enabled>
                                <wikiagent.eval.output-dir>${eval.output.dir}</wikiagent.eval.output-dir>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>light</id>
            <activation>
                <property>
                    <name>test.profile</name>
                    <value>light</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
